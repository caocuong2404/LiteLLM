# Copy to .env and fill in the values. .env is gitignored — never commit real keys.
#
#   cp .env.example .env

# Encrypts sensitive values the proxy stores in its database. Must stay the
# same across restarts or stored data cannot be decrypted.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
LITELLM_SALT_KEY=replace-me

# Allows the proxy to start with no master key. The proxy then serves
# unauthenticated — fine on loopback, but see "Security" in README.md.
# To require a key instead, set LITELLM_MASTER_KEY and drop this line.
LITELLM_DANGEROUSLY_PERMIT_WEAK_OR_UNSET_MASTER_KEY=true

# --- Provider credentials, one per route in config.yaml ---

# claude-haiku-5 -> openrouter/minimax/minimax-m3.1-flash:free
OPENROUTER_API_KEY=replace-me

# claude-opus-5, claude-sonnet-5 -> anthropic/mimo-v2.x-pro
MIMO_API_KEY=replace-me

# claude-haiku-5-plus -> anthropic/minimax/minimax-m3.1-flash:free via Kilo
KILO_API_KEY=replace-me

# claude-haiku-5-olm -> anthropic/minimax/minimax-m3.1-flash:cloud
OLLAMA_API_KEY=replace-me
# The Ollama endpoint wants the key in an Authorization header too.
OLLAMA_AUTH_HEADER=Bearer replace-me

# --- OpenTelemetry v2 (GenAI metrics: TTFT, TPOT, token usage, cost) ---

LITELLM_OTEL_V2=true
LITELLM_OTEL_INTEGRATION_ENABLE_METRICS=true
OTEL_EXPORTER=otlp_http
# Host collector (../OpenTelemetry) is published on the host's :4318.
# Inside the container "localhost" is the container itself, so use host.docker.internal.
OTEL_ENDPOINT=http://host.docker.internal:4318
OTEL_SERVICE_NAME=litellm
# Inert against the local collector (it runs without auth). Needed only when
# pointing at a backend that requires auth (SigNoz, Honeycomb, ...).
OTEL_HEADERS="api-key=your-key,x-tenant=acme"
